# .env.example —— 可提交的配置模板（复制为 .env 后按环境修改；.env 已被 .gitignore 忽略）
# pra.infra.db.Settings 经 pydantic-settings 读取仓库根 .env（env_file=".env"）。
# 注意：请勿把真实密码提交到任何可提交文件 —— .env.example 仅放占位符。

# MySQL 连接串（aiomysql 异步驱动）。默认开发值指向本地 Docker mysql-dev 容器；
# 生产/预发环境在此覆盖（用户名/密码/主机/库名按实际填写）。
DATABASE_URL=mysql+aiomysql://<user>:<pass>@127.0.0.1:3306/product_review

# 可选：真实 LLM 评测脚本（scripts/run_evaluation.py）的网关凭据。
# Settings 已声明为可选字段（故 .env 可单文件承载两类配置），但 extra="forbid"
# 保持严格 —— 本文件出现未知键名仍会报错，请勿随手自造键。不跑评测可整段删除。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名（provider 前缀写法，缺省 deepseek/deepseek-flash = DeepSeek-V4.1-Flash）
DEEPSEEK_MODEL=deepseek/deepseek-flash

# 可选：Langfuse 可观测性。
# 不配 LANGFUSE_PUBLIC_KEY/SECRET_KEY → 观测关闭（不上报、不联网、不影响测试）；
# 配置后 HTTP 路径的 LangGraph 图调用会上报 trace 到 Langfuse。
# 本地自托管：用 deploy/langfuse/ 起服务后，在 UI 建项目取 key（或直接用 compose 里
# LANGFUSE_INIT_* 预置的值）。**SECRET_KEY 是密钥，勿提交到任何可提交文件。**
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
