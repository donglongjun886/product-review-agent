# .env.example —— 可提交的配置模板（复制为 .env 后按环境修改；.env 已被 .gitignore 忽略）
# pra.infra.db.Settings 经 pydantic-settings 读取仓库根 .env（env_file=".env"）。
# 注意：请勿把真实密码提交到任何可提交文件 —— .env.example 仅放占位符。

# MySQL 连接串（aiomysql 异步驱动）。默认开发值指向本地 Docker mysql-dev 容器；
# 生产/预发环境在此覆盖（用户名/密码/主机/库名按实际填写）。
DATABASE_URL=mysql+aiomysql://<user>:<pass>@127.0.0.1:3306/product_review

# 可选：真实 LLM 评测脚本（scripts/run_evaluation_real.py）的网关凭据。
# Settings 已声明为可选字段（故 .env 可单文件承载两类配置），但 extra="forbid"
# 保持严格 —— 本文件出现未知键名仍会报错，请勿随手自造键。不跑 real 评测可整段删除。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：Langfuse 可观测性（docs/09-langfuse-observability.md）。
# 不配 LANGFUSE_PUBLIC_KEY/SECRET_KEY → pra.observability 走 NullTracer（全 no-op、
# 不联网、不影响测试）；配置后每次 Agent 执行会上报 trace 到 Langfuse。
# 本地自托管：用 deploy/langfuse/ 起服务后，在 UI 建项目取 key（或直接用 compose 里
# LANGFUSE_INIT_* 预置的值）。**SECRET_KEY 是密钥，勿提交到任何可提交文件。**
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
# 总开关（0/false/no/off 关闭；未设 = 有凭据即启用）
PRA_LANGFUSE_ENABLED=1
# 实验版本名（写入 trace version + metadata.experiment；缺省 baseline）
PRA_LANGFUSE_EXPERIMENT=baseline
# 采样率 0.0~1.0（确定性判定：同 trace_id 恒同结果；评测 320 案时可调低）
PRA_LANGFUSE_SAMPLE=1.0
# 会话分组（一次 evaluation run 用同一个，便于 UI 按 session 过滤；评测 CLI 会设置）
PRA_LANGFUSE_SESSION=
