# Langfuse v4 自托管 —— 环境变量模板
# 用法：cp .env.example .env 然后把所有 <CHANGEME...> 换成真随机值。
# 生成方式（macOS/Linux 通用）：
#   openssl rand -hex 32
# 注意：SALT / ENCRYPTION_KEY 一旦用于写入数据就不要再改，否则已存数据无法解密。

# ---------- 基础 ----------
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# ---------- 加密 / 会话 ----------
SALT=<CHANGEME_openssl_rand_hex_32>
ENCRYPTION_KEY=<CHANGEME_openssl_rand_hex_32>
NEXTAUTH_SECRET=<CHANGEME_openssl_rand_hex_32>

# ---------- Postgres ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGEME_openssl_rand_hex_32>
POSTGRES_DB=postgres
# 密码必须与上面的 POSTGRES_PASSWORD 一致
DATABASE_URL=postgresql://postgres:<CHANGEME_openssl_rand_hex_32>@postgres:5432/postgres

# ---------- ClickHouse ----------
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=<CHANGEME_openssl_rand_hex_32>

# ---------- Redis ----------
REDIS_AUTH=<CHANGEME_openssl_rand_hex_32>

# ---------- MinIO / S3 ----------
# SECRET_ACCESS_KEY 必须与 MINIO_ROOT_PASSWORD 一致（同一套 minio 凭据）
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=<CHANGEME_openssl_rand_hex_32>
LANGFUSE_S3_EVENT_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<CHANGEME_same_as_MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_BUCKET=langfuse
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<CHANGEME_same_as_MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_ACCESS_KEY_ID=minio
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<CHANGEME_same_as_MINIO_ROOT_PASSWORD>

# ---------- 首次启动自动初始化（组织 / 项目 / 用户 / API 密钥） ----------
# 非敏感，可保持默认；改这里即可改 UI 初始账号与项目名
LANGFUSE_INIT_ORG_ID=pra-local
LANGFUSE_INIT_ORG_NAME=PRA Local
LANGFUSE_INIT_PROJECT_ID=pra-local
LANGFUSE_INIT_PROJECT_NAME=product-review-agent
# ⚠️ 下面这对 key 是**本地自托管的固定初始化值，不是机密**（人读可辨的 `-local` 后缀），
# 以便开箱即用；`deploy/langfuse` 仅绑 127.0.0.1，**不要**在对外暴露的实例上沿用 →
# 对外部署时改成自己生成的值（任意随机串即可，UI 里也可随时重建 key）。
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-pra-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-pra-local
LANGFUSE_INIT_USER_EMAIL=admin@local.dev
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=<CHANGEME_openssl_rand_hex_32>
